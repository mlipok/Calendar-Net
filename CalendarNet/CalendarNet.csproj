<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <RootNamespace>CalendarNet</RootNamespace>
    <AssemblyName>CalendarNet</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Update="Calendar.cs"><SubType>UserControl</SubType></Compile>
    <Compile Update="Calendar.Designer.cs"><DependentUpon>Calendar.cs</DependentUpon></Compile>
    <EmbeddedResource Update="Calendar.resx"><DependentUpon>Calendar.cs</DependentUpon></EmbeddedResource>
    <EmbeddedResource Include="Icons\*.png" />
  </ItemGroup>
</Project>